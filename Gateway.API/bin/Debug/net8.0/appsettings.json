{
  "ReverseProxy": {
    "Routes": {
      "book-route": {
        "ClusterId": "book-cluster",
        "Match": {
          "Path": "/api/books/{**catch-all}"
        }
      },

      "borrow-route": {
        "ClusterId": "borrow-cluster",
        "Match": {
          "Path": "/api/borrow/{**catch-all}"
        }
      },

      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      }
    },

    "Clusters": {

      "book-cluster": {
        "Destinations": {
          "d1": {
            "Address": "https://localhost:7162/"
          }
        }
      },

      "borrow-cluster": {
        "Destinations": {
          "d1": {
            "Address": "https://localhost:7245/"
          }
        }
      },

      "auth-cluster": {
        "Destinations": {
          "d1": {
            "Address": "https://localhost:7267/"
          }
        }
      }

    }
  }
}